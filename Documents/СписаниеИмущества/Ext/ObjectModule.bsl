Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    Для Каждого ТекСтрока Из Состав Цикл
        
        // Подготовка параметров для вызова функции из Canvas
        ПараметрыПроверки = Новый Структура;
        ПараметрыПроверки.Вставить("Имущество",        ТекСтрока.Имущество);
        ПараметрыПроверки.Вставить("Количество",       ТекСтрока.Количество);
        ПараметрыПроверки.Вставить("Кабинет",          Кабинет); // Для Списания
        ПараметрыПроверки.Вставить("ПроверятьОстаток", Истина);
        
        // ВНИМАНИЕ: Используем новое имя функции ПроверитьВозможностьДвижения
        Результат = ИнвентаризацияСервер.ПроверитьВозможностьДвижения(ПараметрыПроверки);
        
        Если Не Результат.Успех Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = Результат.Сообщение;
            Сообщение.Сообщить();
            
            Отказ = Истина; // Прерываем проведение
        КонецЕсли;
        
    КонецЦикла;
    
КонецПроцедуры

