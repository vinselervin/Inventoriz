&НаКлиенте
Процедура СоставИмуществоПриИзменении(Элемент)
    
    ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
    
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Передача данных: передаем Имущество и Кабинет в общий модуль
    Доступно = ИнвентаризацияСервер.ПроверитьДоступныйОстаток(ТекущиеДанные.Имущество, Объект.Кабинет);
    
    // Обработка данных
    Если Доступно = 0 Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Внимание! Данного имущества нет в выбранном кабинете.";
        Сообщение.Поле = "Объект.Состав[" + Элементы.Состав.ТекущаяСтрока + "].Имущество";
        Сообщение.Сообщить();
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура СоставКоличествоПриИзменении(Элемент)
    
    ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
    
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Подготовка структуры для передачи (Упаковка данных)
    ДанныеОперации = Новый Структура("Имущество, Количество", ТекущиеДанные.Имущество, ТекущиеДанные.Количество);
    
    // Использование блока Попытка-Исключение для обработки ошибок интеграции
    Попытка
        // Вызов функции другого модуля
        Результат = ИнвентаризацияСервер.ВыполнитьДвижениеИмущества(ДанныеОперации);
        
        Если Не Результат.Успех Тогда
            // Если бизнес-логика вернула ложь
            ВызватьИсключение Результат.Сообщение;
        КонецЕсли;
        
    Исключение
        // ИСПРАВЛЕНО: Используем стандартный метод ПоказатьПредупреждение или СообщениеПользователю
        // Ошибка "ОбщегоНазначенияКлиентСервер" исправлена заменой на встроенные средства
        ТекстОшибки = ОписаниеОшибки();
        
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = ТекстОшибки;
        Сообщение.Сообщить();
        
        ТекущиеДанные.Количество = 0; // Сброс некорректных данных
    КонецПопытки;
    
КонецПроцедуры