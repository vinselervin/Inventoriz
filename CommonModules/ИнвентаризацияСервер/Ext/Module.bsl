#Область ПрограммныйИнтерфейс

// Главная функция для проверки возможности проведения операции.
// Принимает структуру данных и возвращает результат проверки.
// Параметры:
//  ПараметрыОперации - Структура: Имущество, Количество, Кабинет, ПроверятьОстаток.
// Возвращает:
//  Структура: Успех (Булево), Сообщение (Строка).
Функция ПроверитьВозможностьДвижения(ПараметрыОперации) Экспорт
	
	Результат = Новый Структура("Успех, Сообщение", Истина, "");
	
	Попытка
		// 1. Валидация входных данных (базовые проверки)
		Если Не ЗначениеЗаполнено(ПараметрыОперации.Имущество) Тогда
			ВызватьИсключение "Не выбрано имущество в одной из строк.";
		КонецЕсли;
		
		Если ПараметрыОперации.Количество <= 0 Тогда
			ВызватьИсключение "Количество должно быть больше нуля (" + Строка(ПараметрыОперации.Имущество) + ").";
		КонецЕсли;
		
		// 2. Проверка остатков (актуально для Списания и Перемещения)
		Если ПараметрыОперации.Свойство("ПроверятьОстаток") И ПараметрыОперации.ПроверятьОстаток Тогда
			
			// Проверка заполнения кабинета перед вызовом запроса (важно для исключения ОшибкиХранимыхДанных)
			Если Не ЗначениеЗаполнено(ПараметрыОперации.Кабинет) Тогда
				ВызватьИсключение "Для проверки остатков должен быть указан кабинет.";
			КонецЕсли;
			
			Остаток = ТекущийОстатокИмущества(ПараметрыОперации.Имущество, ПараметрыОперации.Кабинет);
			
			Если Остаток < ПараметрыОперации.Количество Тогда
				ВызватьИсключение СтрШаблон("Недостаточно имущества '%1' в кабинете '%2'. В наличии: %3, требуется: %4", 
					Строка(ПараметрыОперации.Имущество), Строка(ПараметрыОперации.Кабинет), Остаток, ПараметрыОперации.Количество);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		// Захват и возврат текста ошибки
		Результат.Успех = Ложь;
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Получает актуальный остаток из регистра накопления.
// Параметры:
//  Имущество - СправочникСсылка.Имущество
//  Кабинет   - СправочникСсылка.Кабинеты
// Возвращает:
//  Число - Количество остатка.
Функция ТекущийОстатокИмущества(Имущество, Кабинет) Экспорт
	
	// Очистка параметров от возможных битых ссылок или неопределенных значений
	ПараметрИмущество = ?(Имущество = Неопределено, Справочники.Имущество.ПустаяСсылка(), Имущество);
	ПараметрКабинет   = ?(Кабинет   = Неопределено, Справочники.Кабинеты.ПустаяСсылка(), Кабинет);
	
	Запрос = Новый Запрос;
	// Используем ЕСТЬNULL и передаем пустую дату в параметры таблицы для стабильности
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ОстаткиИмуществаОстатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиИмущества.Остатки(&Период, Имущество = &Имущество И Кабинет = &Кабинет) КАК ОстаткиИмуществаОстатки";
	
	Запрос.УстановитьПараметр("Имущество", ПараметрИмущество);
	Запрос.УстановитьПараметр("Кабинет",   ПараметрКабинет);
	Запрос.УстановитьПараметр("Период",    ТекущаяДата()); // Указываем дату, чтобы запрос не падал на расчете текущих итогов
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Остаток;
	КонецЕсли;
	
КонецФункции

#КонецОбласти