&НаКлиенте
Процедура ВыбратьФото(Команда)
    
    // Создаем описание оповещения, которое сработает ПОСЛЕ выбора файла
    Оповещение = Новый ОписаниеОповещения("ВыбратьФотоЗавершение", ЭтотОбъект);
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Картинки (*.jpg;*.png)|*.jpg;*.png";
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = "Выберите фотографию имущества";
    
    // Используем асинхронный метод Показать вместо Выбрать
    Диалог.Показать(Оповещение);
    
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФотоЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    
    Если ВыбранныеФайлы <> Неопределено Тогда
        ПолноеИмяФайла = ВыбранныеФайлы[0];
        
        // Оповещение для завершения помещения файла на сервер
        ОповещениеЗавершения = Новый ОписаниеОповещения("ПоместитьФотоЗавершение", ЭтотОбъект);
        
        // Современный метод для передачи файла с клиента на сервер
        НачатьПомещениеФайлаНаСервер(ОповещениеЗавершения, , , , ПолноеИмяФайла, УникальныйИдентификатор);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьФотоЗавершение(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
    
    // Проверяем, что файл успешно помещен
    Если ОписаниеПомещенногоФайла <> Неопределено И ОписаниеПомещенногоФайла.Адрес <> Неопределено Тогда
        // Записываем адрес во временное хранилище в РЕКВИЗИТ ФОРМЫ
        // Проверьте, что АдресФото добавлен в список реквизитов формы (справа в конфигураторе)
        АдресФото = ОписаниеПомещенногоФайла.Адрес;
        ЭтаФорма.Модифицированность = Истина
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    // Сохраняем из временного хранилища в реквизит объекта (тип ХранилищеЗначения)
    // Проверяем именно АдресФото, который должен быть реквизитом формы
    Если ЭтоАдресВременногоХранилища(АдресФото) Тогда
        ТекущийОбъект.ДанныеФайлаФото = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресФото));
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    // При открытии карточки получаем ссылку на данные для отображения в поле картинки
    // ДанныеФайлаФото — это реквизит справочника с типом ХранилищеЗначения
    Если ЗначениеЗаполнено(ТекущийОбъект.ДанныеФайлаФото) Тогда
        АдресФото = ПолучитьНавигационнуюСсылку(ТекущийОбъект.Ссылка, "ДанныеФайлаФото");
    Иначе
        АдресФото = "";
    КонецЕсли;
КонецПроцедуры